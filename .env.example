# ============================================
# USER SETTINGS
# ============================================
USER_NAME=

# ============================================
# FAST BRAIN (OpenAI-compatible) - MANDATORY
# ============================================
FAST_BRAIN_API_KEY=your_key_here
FAST_BRAIN_MODEL=llama-3.3-70b-versatile
FAST_BRAIN_ENDPOINT=https://api.groq.com/openai/v1

# ============================================
# SEMANTIC ROUTER (OpenAI-compatible) - MANDATORY
# ============================================
ROUTER_API_KEY=your_key_here
ROUTER_MODEL=llama-3.3-70b-versatile
ROUTER_ENDPOINT=https://api.groq.com/openai/v1

# ============================================
# IMAGE GENERATION (OpenAI-compatible) - MANDATORY for image gen
# ============================================
IMAGE_GEN_API_KEY=your_key_here
IMAGE_GEN_MODEL=dall-e-3
IMAGE_GEN_ENDPOINT=https://api.openai.com/v1

# ============================================
# LTM EXTRACTION (OpenAI-compatible) - MANDATORY for memory learning
# ============================================
LTM_EXTRACTION_API_KEY=your_key_here
LTM_EXTRACTION_MODEL=llama-3.3-70b-versatile
LTM_EXTRACTION_ENDPOINT=https://api.groq.com/openai/v1

# ============================================
# TEXT-TO-SPEECH (OPTIONAL - falls back to Edge TTS)
# ============================================
TTS_API_KEY=
TTS_ENDPOINT=

# ============================================
# AGENTIC BRAIN - PRIMARY PROVIDER (OpenAI-compatible)
# ============================================
PRIMARY_API_KEY=your_key_here
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=gpt-4o-mini
PRIMARY_THINKING_ENABLED=true

# ============================================
# AGENTIC BRAIN - FALLBACK PROVIDER (OpenAI-compatible)
# ============================================
FALLBACK_API_KEY=your_key_here
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini
FALLBACK_THINKING_ENABLED=true

# ============================================
# SEARCH & EMBEDDINGS (OPTIONAL)
# ============================================
GEMINI_API_KEY=
TAVILY_API_KEY=

# ============================================
# PROACTIVE AGENT (OpenAI-compatible)
# ============================================
PROACTIVE_API_KEY=your_key
PROACTIVE_MODEL=llama-3.3-70b-versatile
PROACTIVE_ENDPOINT=https://api.groq.com/openai/v1

# ============================================
# MESSAGING & COMMUNICATION (OPTIONAL)
# ============================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DEEPGRAM_API_KEY=

# ============================================
# API ENDPOINTS (OPTIONAL - default works)
# ============================================
API_BASE_URL=https://jarvis-os-agent.vercel.app

# ============================================
# TELEGRAM BOT (OPTIONAL - only if using Telegram bot)
# ============================================
TELEGRAM_BOT_USERNAME=@YourJarvisBotUsername